{
  "name": "@invoice-builder/core",
  "version": "1.0.0",
  "private": true,
  "description": "Shared backend services, database infrastructure, utilities, and migrations.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "require": "./dist/*.js",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@invoice-builder/contracts": "*",
    "pg": "^8.20.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  }
}